#!/bin/sh
JBROOT=""
if command -v jbroot >/dev/null 2>&1; then
    JBROOT="$(jbroot / 2>/dev/null | sed 's:/$::')"
fi
if [ -z "$JBROOT" ]; then
    for d in /var/containers/Bundle/Application/.jbroot-* /private/var/containers/Bundle/Application/.jbroot-*; do
        if [ -d "$d" ]; then
            JBROOT="$d"
            break
        fi
    done
fi

if [ -n "$JBROOT" ] && [ -d "$JBROOT" ]; then
    for sub in "Library/MobileSubstrate/DynamicLibraries" "Library/PreferenceBundles/CarSplitVNPrefs.bundle" "Applications/CarSplitVN.app"; do
        if [ -d "$JBROOT/$sub" ] && [ ! -e "$JBROOT/$sub/.jbroot" ]; then
            ln -s "$JBROOT" "$JBROOT/$sub/.jbroot" 2>/dev/null || true
        fi
    done
fi

UICACHE_BIN=""
for u in "$JBROOT/usr/bin/uicache" /usr/bin/uicache /var/jb/usr/bin/uicache "$(command -v uicache 2>/dev/null)"; do
    if [ -n "$u" ] && [ -x "$u" ]; then
        UICACHE_BIN="$u"
        break
    fi
done

if [ -n "$UICACHE_BIN" ]; then
    if [ -n "$JBROOT" ] && [ -d "$JBROOT/Applications/CarSplitVN.app" ]; then
        "$UICACHE_BIN" -p "$JBROOT/Applications/CarSplitVN.app" >/dev/null 2>&1 || true
    fi
    if [ -d "/Applications/CarSplitVN.app" ]; then
        "$UICACHE_BIN" -p /Applications/CarSplitVN.app >/dev/null 2>&1 || true
    fi
fi
exit 0
